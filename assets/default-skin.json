{
  "colors": {
    "black": "#000000",
    "white": "#FFFFFF",
    "gold": "#FFD700",
    "cyan": "#00FFFF",
    "deepBlue": "#203070",
    "darkGreen": "#1F5030",
    "teal": "#00A0A0",
    "hotPink": "#FF40C0",
    "darkGray": "#404040",
    "gray": "#909090",
    "charcoal": "#303030",
    "transparent": "#00000000"
  },
  "labels": {
    "text": { "font": "square", "foreground": "white", "background": "black" },
    "windowText": { "font": "square", "foreground": "white", "background": "charcoal" },
    "tallText": { "font": "tall", "foreground": "white", "background": "black" },
    "title": { "font": "tall", "foreground": "gold", "background": "black" },
    "highlight": { "font": "square", "foreground": "black", "background": "cyan" },
    "accent": { "font": "square", "foreground": "black", "background": "gold" },
    "overlayText": { "font": "square", "foreground": "gold", "background": "transparent" },
    "tallOverlayText": { "font": "tall", "foreground": "gold", "background": "transparent" },
    "tooltip": { "font": "square", "foreground": "white", "background": "charcoal" },
    "tallTooltip": { "font": "tall", "foreground": "gold", "background": "charcoal" }
  },
  "buttons": {
    "button": {
      "normal": { "font": "square", "foreground": "white", "background": "deepBlue" },
      "pointerOver": { "font": "square", "foreground": "black", "background": "teal" },
      "pressed": { "font": "square", "foreground": "black", "background": "gold" },
      "disabled": { "font": "square", "foreground": "gray", "background": "darkGray" },
      "focused": { "font": "square", "foreground": "black", "background": "cyan" }
    },
    "tallButton": {
      "normal": { "font": "tall", "foreground": "white", "background": "deepBlue" },
      "pointerOver": { "font": "tall", "foreground": "black", "background": "teal" },
      "pressed": { "font": "tall", "foreground": "black", "background": "gold" },
      "disabled": { "font": "tall", "foreground": "gray", "background": "darkGray" },
      "focused": { "font": "tall", "foreground": "black", "background": "cyan" }
    }
  },
  "menuBars": {
    "menuBar": {
      "titles": "button", "items": "button",
      "triggerColor": "hotPink", "triggerUnderline": true
    },
    "tallMenuBar": {
      "titles": "tallButton", "items": "tallButton",
      "triggerColor": "hotPink", "triggerUnderline": true
    }
  },
  "checkBoxes": {
    "checkBox": { "button": "button", "unchecked": "[ ]", "checked": "[x]" },
    "tallCheckBox": { "button": "tallButton", "unchecked": "[ ]", "checked": "[x]" }
  },
  "radioButtons": {
    "radioButton": { "button": "button", "unchecked": "( )", "checked": "(*)" },
    "tallRadioButton": { "button": "tallButton", "unchecked": "( )", "checked": "(*)" }
  },
  "textFields": {
    "default": {
      "normal": { "font": "square", "foreground": "white", "background": "deepBlue" },
      "focused": { "font": "square", "foreground": "white", "background": "teal" },
      "disabled": { "font": "square", "foreground": "gray", "background": "darkGray" },
      "placeholder": { "font": "square", "foreground": "gray", "background": "deepBlue" },
      "caret": { "foreground": "deepBlue", "background": "white", "blinkSeconds": 0.5 }
    }
  },
  "progressBars": {
    "progressBar": {
      "fill": { "font": "square", "foreground": "gold", "background": "darkGray" },
      "empty": { "font": "square", "foreground": "gold", "background": "darkGray" }
    },
    "tallProgressBar": {
      "fill": { "font": "tall", "foreground": "gold", "background": "darkGray" },
      "empty": { "font": "tall", "foreground": "gold", "background": "darkGray" }
    }
  },
  "sliders": {
    "slider": {
      "track": {
        "normal": { "font": "square", "foreground": "gray", "background": "black" },
        "focused": { "font": "square", "foreground": "cyan", "background": "black" },
        "disabled": { "font": "square", "foreground": "darkGray", "background": "black" }
      },
      "knob": {
        "normal": { "font": "square", "foreground": "white", "background": "black" },
        "focused": { "font": "square", "foreground": "cyan", "background": "black" },
        "disabled": { "font": "square", "foreground": "darkGray", "background": "black" }
      }
    },
    "tallSlider": {
      "track": {
        "normal": { "font": "tall", "foreground": "gray", "background": "black" },
        "focused": { "font": "tall", "foreground": "cyan", "background": "black" },
        "disabled": { "font": "tall", "foreground": "darkGray", "background": "black" }
      },
      "knob": {
        "normal": { "font": "tall", "foreground": "white", "background": "black" },
        "focused": { "font": "tall", "foreground": "cyan", "background": "black" },
        "disabled": { "font": "tall", "foreground": "darkGray", "background": "black" }
      }
    }
  },
  "scrollPanes": {
    "scrollPane": {
      "track": "darkGray",
      "thumb": "gray",
      "thumbPointerOver": "white",
      "thumbPressed": "gold"
    }
  },
  "windows": {
    "window": {
      "box": "rounded",
      "border": { "font": "square", "foreground": "gray", "background": "charcoal" },
      "focusedBorder": { "font": "square", "foreground": "cyan", "background": "charcoal" },
      "title": { "font": "square", "foreground": "gold", "background": "charcoal" },
      "background": "charcoal",
      "closeButton": "button",
      "closeText": "x"
    }
  },
  "dialogs": {
    "dialog": {
      "window": "window",
      "message": "windowText",
      "buttons": "button",
      "textField": "default",
      "dimColor": "black",
      "dimAmount": 0.5
    }
  }
}

{
  groups: {
    uppercase:   [ "A-Z", "Æ", "Γ", "Θ", "Σ", "Φ", "Ω" ],
    lowercase:   [ "a-z", "ı", "æ", "ƒ", "α", "ß", "δ", "ε", "µ", "π", "σ", "τ", "φ" ],
    digits:      [ "0-9" ],
    punctuation: [ "!-/", ":-@", "[-`", "{-~", "¶", "§", "‼", "¡", "¢", "¥", "«", "¬", "»", "¿", "⌐", "£", "₧", "ª", "º",
                   "∞", "∩", "≡", "±", "≥", "≤", "÷", "≈", "°", "√", "ⁿ", "²",
                   "×", "≠", "…", "—", "€" ],
    descenders:  [ "g", "j", "p", "q", "y", "ƒ", "µ", "φ" ],
    ascenders:   [ "b", "d", "f", "h", "k", "l", "ƒ", "ß", "δ" ],
    tallStems:   [ "i", "j", "t", "φ" ],
    symbols:     [ "@", "☺", "☻", "♥", "♦", "♣", "♠", "•", "○", "◘", "◙", "♂", "♀", "♪", "♫", "☼", "↑", "↓", "→", "←", "↕", "↨", "↔", "▲", "▼", "►", "◄", "∟", "⌂", "▬", "■", "½", "¼", "∙", "·", "↖", "↗", "↘", "↙", "↵", "↺", "↻", "⇐", "⇑", "⇒", "⇓",
                   "□", "▪", "▫", "△", "▴", "▷", "▸", "▽", "▾", "◁", "◂", "◉", "◎", "●", "◐", "◑", "◢", "◣", "◤", "◥", "☐", "☑", "☒",
                   "★", "☆", "☠", "⚑", "⚔", "⚠", "✓", "✗", "⌛", "☁", "⚓", "⚗", "⚙", "⚡", "⛏", "❄",
                   "☂", "☃", "♩", "♬", "⚒", "⛰", "⛺", "✚",
                   "☢", "☣", "⛫", "⛵",
                   "♔", "♕", "♖", "♗", "♘", "♙", "♚", "♛", "♜", "♝", "♞", "♟",
                   "♡", "♢", "♤", "♧", "⚀", "⚁", "⚂", "⚃", "⚄", "⚅",
                   "⏴", "⏵", "⏸", "⏹", "⏺",
                   "U+1FBC5-U+1FBC9", "U+1FBF0-U+1FBF9" ],
    accented:    [ "Ä", "Å", "Ç", "É", "Ñ", "Ö", "Ü", "U+E841", "U+E845", "U+E84E", "U+E84F", "U+E855",
                   "à", "á", "â", "ä", "å", "ç", "è", "é", "ê", "ë", "ì", "í", "î", "ï", "ñ", "ò", "ó", "ô", "ö", "ù", "ú", "û", "ü", "ÿ" ],
    marks:       [ "¨", "´", "¸", "ˆ", "ˋ", "˚", "˜" ],
    tiling:      [ "U+2500-U+259F", "U+1FB40-U+1FB9B", "U+1FBA0-U+1FBAE", "U+1FBD0-U+1FBDF" ]
  },
  rules: [
    {
      name: "Blank ring",
      check: ring,
      size: 1,
      appliesTo: [ all ],
      except: [
        { group: tiling, why: "joins its neighbors" },
        { glyphs: [ "_" ], why: "joins its neighbors into one line" },
        { glyphs: [ "◘", "◙", "▬", "◢", "◣", "◤", "◥" ], why: "fills the cell, meant for drawing" },
        { glyphs: [ "⌠", "⌡" ], why: "halves join into one tall integral" }
      ]
    },
    {
      name: "Centered across",
      check: centeredX,
      appliesTo: [ uppercase, lowercase, digits, punctuation, marks, accented ],
      except: [
        { glyphs: [ "¸" ], why: "hangs under the letter, not the cell" }
      ]
    },
    {
      name: "Symbols centered both ways",
      check: centeredBoth,
      appliesTo: [ symbols ],
      except: [
        { glyphs: [ "☣" ], why: "odd height, can't center" },
        { glyphs: [ "♙", "♟" ], why: "stands on the chess base line" },
        { glyphs: [ "♘", "♞" ], why: "faces left" },
        { glyphs: [ "U+1FBF1" ], why: "uses the right segments like a real display" }
      ]
    },
    {
      name: "Capitals start at the cap line",
      check: noInkRows,
      rows: [ 1 ],
      appliesTo: [ uppercase, digits ]
    },
    {
      name: "Nothing below the baseline",
      check: noInkRows,
      rows: [ "12-14" ],
      appliesTo: [ uppercase, lowercase, digits ],
      except: [
        { group: descenders, why: "tails drop into rows 12-14" },
        { glyphs: [ "Q" ], why: "tail reaches row 12" }
      ]
    },
    {
      name: "Lowercase stays under the x-height",
      check: noInkRows,
      rows: [ "1-5" ],
      appliesTo: [ lowercase ],
      except: [
        { group: ascenders, why: "ascenders rise to row 1" },
        { group: tallStems, why: "dot or stem starts at row 3" }
      ]
    }
  ]
}
